# Copy to .env and adjust. Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------- IRIS image
# Tag printed by `docker load -i <AI Hub image>.tar.gz`
IRIS_IMAGE=intersystems/iris-community:2027.1.0AI.109.0
# License key: put the .key file (e.g. iris-container-x64.key) in the ./keys folder.

# ---------------------------------------------------------------- LLM (managed by AI Hub, %AI.Provider)
# Provider: openai | anthropic | ...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional: stronger model only for the AI Analyst (agent); empty = uses LLM_MODEL
LLM_AGENT_MODEL=gpt-4o
# Optional: OpenAI-compatible endpoint (Azure, Ollama, vLLM, LM Studio)
LLM_BASE_URL=

# ---------------------------------------------------------------- privacy
# 1 = no data value is ever sent to the LLM: only the question and metadata (names, descriptions,
# relationships, glossary). "Analyze result" uses numeric statistics only and the AI Analyst never sees values.
# Recommended for personal/sensitive data (e.g. LGPD/GDPR/HIPAA scenarios).
PRIVACY_MODE=0
# Privacy mode: minimum rows for numeric statistics to be shared with the AI (smaller results share none)
PRIVACY_MIN_ROWS=10

# ---------------------------------------------------------------- data
# 1 = build the demo dataset (US retail chain); 0 = empty install to use your own tables
COPILOT_DEMO=1
# Namespace the portal connects to
IRIS_NAMESPACE=COPILOT
# Optional allow-list of schemas the AI can see (comma separated), e.g. Sales,Finance
VISIBLE_SCHEMAS=
# Optional extra schema prefixes to hide (comma separated)
HIDDEN_SCHEMAS=
# Schema where the portal creates user views
VIEW_SCHEMA=Analytics
# Max rows returned per query
MAX_ROWS=1000
# Real-time sales simulator, demo dataset only (seconds between orders; 0 disables it)
SIMULATOR_INTERVAL=5

# ---------------------------------------------------------------- UI
# Default AI answer language when the UI does not send one (en | pt).
# Each user picks EN or PT-BR in the portal; the choice applies to the UI and to the AI.
COPILOT_LANG=en

# ---------------------------------------------------------------- host ports
WEB_PORT=8080
IRIS_PORT=1972
IRIS_WEB_PORT=52773

# ---------------------------------------------------------------- external IRIS (docker-compose.external.yml only)
EXTERNAL_IRIS_HOST=host.docker.internal
EXTERNAL_IRIS_PORT=1972
