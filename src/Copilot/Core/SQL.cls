/// Guarded execution of SQL generated by the AI or typed by the user.
///
/// Safety rules (read-only):
///   - a single SELECT / WITH statement
///   - no write/DDL keyword outside literals
///   - the SQL privileges of the signed-in IRIS user still apply (the portal connects as that user)
Class Copilot.Core.SQL Extends %RegisteredObject
{

Parameter FORBIDDEN = "INSERT,UPDATE,DELETE,DROP,ALTER,CREATE,TRUNCATE,GRANT,REVOKE,CALL,EXECUTE,EXEC,INTO,MERGE,PURGE,KILL";

/// Removes trailing semicolons and whitespace.
ClassMethod Normalize(sql As %String) As %String
{
    Set s = $ZStrip(sql, "<>WC")
    While $Extract(s, *)=";" {
        Set s = $ZStrip($Extract(s, 1, *-1), "<>WC")
    }
    Quit s
}

/// "" when the statement is a read-only query; otherwise the reason.
ClassMethod Validate(sql As %String) As %String
{
    Set s = ..Normalize(sql)
    Quit:s="" ##class(Copilot.Core.Config).T("A consulta está vazia.", "The query is empty.")
    // strip literals and quoted identifiers before scanning keywords
    Set bare = ..StripLiterals(s)
    Quit:bare["--" ##class(Copilot.Core.Config).T("Comentários não são permitidos na consulta.", "Comments are not allowed in the query.")
    Quit:bare["/*" ##class(Copilot.Core.Config).T("Comentários não são permitidos na consulta.", "Comments are not allowed in the query.")
    Quit:bare[";" ##class(Copilot.Core.Config).T("Apenas uma instrução SQL é permitida.", "Only one SQL statement is allowed.")
    Set words = $ZConvert($Translate(bare, "(),.=<>+-*/|!:?"_$Char(9,10,13), "                     "), "U")
    Set first = $Piece($ZStrip(words, "<W"), " ")
    Quit:(first'="SELECT")&&(first'="WITH") ##class(Copilot.Core.Config).T("Somente consultas SELECT são permitidas pelo portal.", "Only SELECT queries are allowed by the portal.")
    Set forbidden = ..#FORBIDDEN
    For i=1:1:$Length(words, " ") {
        Set w = $Piece(words, " ", i)
        Continue:w=""
        Return:(","_forbidden_",")[(","_w_",") ##class(Copilot.Core.Config).T("Comando não permitido: ", "Command not allowed: ")_w
    }
    Quit ""
}

ClassMethod StripLiterals(s As %String) As %String
{
    Set out = "", i = 1, len = $Length(s)
    While i <= len {
        Set c = $Extract(s, i)
        If (c="'") || (c="""") {
            Set j = i + 1
            For {
                Quit:j>len
                If $Extract(s, j)=c {
                    If $Extract(s, j + 1)=c {
                        Set j = j + 2
                        Continue
                    }
                    Quit
                }
                Set j = j + 1
            }
            Set out = out_" X "
            Set i = j + 1
            Continue
        }
        Set out = out_c, i = i + 1
    }
    Quit out
}

/// Validates and runs. Returns {"columns":[{name,type}],"rows":[[...]],"rowCount","truncated","elapsedMs"}
/// or throws with the IRIS message (used by the AI self-correction loop).
ClassMethod Run(sql As %String, maxRows As %Integer = "") As %DynamicObject
{
    Set:maxRows="" maxRows = ##class(Copilot.Core.Config).MaxRows()
    Set error = ..Validate(sql)
    If error'="" {
        $$$ThrowStatus($$$ERROR($$$GeneralError, error))
    }
    Set start = $ZHorolog
    Set stmt = ##class(%SQL.Statement).%New()
    Set stmt.%SelectMode = 1
    Set sc = stmt.%Prepare(..Normalize(sql))
    If $$$ISERR(sc) {
        $$$ThrowStatus($$$ERROR($$$GeneralError, ..CleanError($System.Status.GetErrorText(sc))))
    }
    Set rs = stmt.%Execute()
    If rs.%SQLCODE < 0 {
        $$$ThrowStatus($$$ERROR($$$GeneralError, "SQLCODE "_rs.%SQLCODE_": "_rs.%Message))
    }
    Set meta = rs.%GetMetadata(), ncols = meta.columns.Count(), columns = []
    For c=1:1:ncols {
        Set col = meta.columns.GetAt(c)
        Set kind(c) = ..Kind(col.clientType)
        Do columns.%Push({"name": (col.colName), "type": (kind(c))})
    }
    Set rows = [], n = 0, truncated = 0
    While rs.%Next(.sc) {
        Set n = n + 1
        If n > maxRows {
            Set truncated = 1, n = maxRows
            Quit
        }
        Set row = []
        For c=1:1:ncols {
            Set value = rs.%GetData(c)
            If value="" {
                Do row.%Push("", "null")
            } ElseIf (kind(c)="number") && $IsValidNum(value) {
                Do row.%Push(+value, "number")
            } Else {
                Do row.%Push(value)
            }
        }
        Do rows.%Push(row)
    }
    If $$$ISERR(sc) {
        $$$ThrowStatus($$$ERROR($$$GeneralError, ..CleanError($System.Status.GetErrorText(sc))))
    }
    If rs.%SQLCODE < 0 {
        $$$ThrowStatus($$$ERROR($$$GeneralError, "SQLCODE "_rs.%SQLCODE_": "_rs.%Message))
    }
    Quit {"columns": (columns), "rows": (rows), "rowCount": (n), "truncated": (truncated), "elapsedMs": (($ZHorolog - start) * 1000 \ 1)}
}

/// Logical type for the UI from the ODBC clientType.
ClassMethod Kind(clientType As %Integer) As %String
{
    Quit:$ListFind($ListBuild(3, 5, 14, 18, 16), clientType) "number"
    Quit:clientType=2 "date"
    Quit:clientType=9 "timestamp"
    Quit:clientType=8 "time"
    Quit "string"
}

ClassMethod CleanError(text As %String) As %String
{
    Set text = $Replace(text, "ERROR #5540: SQLCODE: ", "SQLCODE ")
    Set text = $Replace(text, "ERROR #5521: SQLCODE: ", "SQLCODE ")
    Quit $ZStrip(text, "<>W")
}

/// Runs a query and returns the rows as Markdown (used by the agent tools).
ClassMethod RunMarkdown(sql As %String, maxRows As %Integer = 50) As %String
{
    Set result = ..Run(sql, maxRows)
    Set nl = $Char(10), header = "|", sep = "|"
    Set iter = result.columns.%GetIterator()
    While iter.%GetNext(, .col) {
        Set header = header_" "_col.name_" |", sep = sep_" --- |"
    }
    Set out = header_nl_sep_nl
    Set iter = result.rows.%GetIterator()
    While iter.%GetNext(, .row) {
        Set line = "|", cells = row.%GetIterator()
        While cells.%GetNext(, .v) {
            Set line = line_" "_$Translate(v, "|"_$Char(10,13), "/  ")_" |"
        }
        Set out = out_line_nl
    }
    Set out = out_nl_"("_result.rowCount_##class(Copilot.Core.Config).T(" linha(s)", " row(s)")_$Select(result.truncated:##class(Copilot.Core.Config).T(", resultado truncado", ", truncated"), 1:"")_")"
    Quit out
}

}
